# ==============================
# 👑 Game of Nodes: Global Gitignore
# ==============================

# 1. Node.js & Dependencies
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# 2. Environment Variables & Secrets (CRITICAL: Never commit these!)
.env
.env.local
.env.development
.env.test
.env.production
*.pem
*.key

# 3. Build & Cache Files
dist/
build/
.cache/
.parcel-cache/
.next/
out/
coverage/

# 4. OS Generated Files (Windows/Mac)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 5. IDEs & Editors (VS Code, IntelliJ, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Docker & Databases (Local volume data)
data/
db/
*.sqlite
*.db
docker-compose.override.yml